# Django
DEBUG=True
SECRET_KEY=django-insecure-evently-dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Tashkent

# Database (PostgreSQL) - if not set or DB_ENGINE=sqlite, defaults to SQLite for dev
DB_ENGINE=sqlite
DB_NAME=evently
DB_USER=evently
DB_PASSWORD=evently
DB_HOST=localhost
DB_PORT=5432

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_dummy_token
TELEGRAM_BOT_USERNAME=EventlyBot
BOT_API_SECRET=dev-bot-api-secret-key
BACKEND_API_URL=http://localhost:8000/api/v1

# Reminders
REMINDER_HOURS_BEFORE=24
